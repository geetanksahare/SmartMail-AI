PROJECT_NAME=SmartMail AI
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=False
ENVIRONMENT=development

CORS_ORIGINS=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smartmail_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password

JWT_SECRET_KEY=your_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

EMAIL_PROVIDER=brevo

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=SmartMail AI
BREVO_SENDER_EMAIL=your_verified_sender_email
EMAIL_TEST_RECIPIENT=your_test_email
BREVO_WEBHOOK_TOKEN=your_brevo_webhook_token

REDIS_URL=rediss://default:your_redis_password@your_redis_endpoint:6379